                  "type": "text",
                  "id": "dIcKU",
                  "name": "Rule",
                  "fill": "#333333",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Status colors and the surface / accent-subtle dark values are shared with fonoster.com; the teal ramp is new to Routr.",
                  "lineHeight": 1.5,
                  "fontFamily": "Poppins",
                  "fontSize": 13,
                  "fontWeight": "normal"
                }
              ]
