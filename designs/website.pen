                  "fill": "#333333",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Teal #5FCFCE is a fill, not light-mode text. On light, text and links use Routr/05 #1F8F8E.",
                  "lineHeight": 1.5,
                  "fontFamily": "Poppins",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "M2xLd",
                  "name": "Rule",
                  "fill": "#333333",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Text on teal is always Routr/07 #001A1A — never white.",
                  "lineHeight": 1.5,
                  "fontFamily": "Poppins",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "mDuZZ",
                  "name": "Rule",
                  "fill": "#333333",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "•  Dark is the default marketing mode, matching fonoster.com. Light mode for docs and long reads.",
                  "lineHeight": 1.5,
                  "fontFamily": "Poppins",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
