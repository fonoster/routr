                        },
                        {
                          "type": "text",
                          "id": "TH04U",
                          "content": "How it runs",
                          "fill": "$text-primary",
                          "fontFamily": "Poppins",
                          "fontSize": 16,
                          "fontWeight": "600"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "1nF3D",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "lineHeight": 1.6,
                      "content": "SIPp places calls (INVITE, 200, ACK, BYE after 1 s) and adds 50 calls/s every minute. The run stops at the first step where p99 reaches 50 ms or failed calls reach 0.1%.",
                      "fill": "$text-secondary",
                      "fontFamily": "Poppins",
                      "fontSize": 14
                    }
                  ]
                }
