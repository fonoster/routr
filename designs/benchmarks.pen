                          "height": 18,
                          "fill": "$accent"
                        },
                        {
                          "type": "text",
                          "id": "mqPja",
                          "content": "Why it matters",
                          "fill": "$text-primary",
                          "fontFamily": "Poppins",
                          "fontSize": 16,
                          "fontWeight": "600"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "b7gEt",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "lineHeight": 1.6,
                      "content": "The EdgePort is the only stateful piece of Routr: it holds every SIP transaction and dialog. When it saturates, calls fail, no matter what runs behind it.",
                      "fill": "$text-secondary",
                      "fontFamily": "Poppins",
                      "fontSize": 14
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "UOQrf",
