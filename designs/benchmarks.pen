                    },
                    {
                      "type": "text",
                      "id": "GDbvv",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "lineHeight": 1.6,
                      "content": "The EdgePort on its own, with Echo answering every request with 200 OK. No Dispatcher, Connect or database, so this is a ceiling for EdgePort alone, not for a full deployment.",
                      "fill": "$text-secondary",
                      "fontFamily": "Poppins",
                      "fontSize": 14
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Nz6bD",
