          "x": 60,
          "y": 676,
          "name": "Text",
          "fill": "$rt-text-muted",
          "textGrowth": "fixed-width",
          "width": 460,
          "content": "Takes turns. Each new call goes to the next registration in the list. The counter lives in each Location Service instance.",
          "lineHeight": 1.5,
          "fontFamily": "Poppins",
          "fontSize": 15,
          "fontWeight": "normal"
        },
        {
          "id": "pDj6N",
          "type": "ref",
          "ref": "PHmh8",
          "name": "Chip least-sessions",
          "x": 570,
          "y": 630,
          "descendants": {
            "goZxA": {
              "content": "least-sessions",
              "fontSize": 16
            }
          }
        },
        {
          "type": "text",
          "id": "jBGcd",
          "x": 570,
          "y": 676,
          "name": "Text",
          "fill": "$rt-text-muted",
          "textGrowth": "fixed-width",
          "width": 460,
          "content": "Sends the call to the registration with the fewest sessions, using the X-Session-Count each PBX reports when it registers. Here: asterisk-02.",
          "lineHeight": 1.5,
          "fontFamily": "Poppins",
          "fontSize": 15,
          "fontWeight": "normal"
        },
        {
          "id": "lgz2H",
          "type": "ref",
          "ref": "PHmh8",
          "name": "Chip withSessionAffinity",
          "x": 1080,
          "y": 630,
          "descendants": {
            "goZxA": {
              "content": "withSessionAffinity",
              "fontSize": 16
            }
          }
        },
        {
          "type": "text",
          "id": "ndEhX",
          "x": 1080,
          "y": 676,
          "name": "Text",
          "fill": "$rt-text-muted",
          "textGrowth": "fixed-width",
          "width": 460,
          "content": "Calls that carry the same value in the Number's sessionAffinityHeader stick to the same PBX. Use Redis so every Location instance shares it.",
          "lineHeight": 1.5,
          "fontFamily": "Poppins",
          "fontSize": 15,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "mYwYh",
          "x": 60,
          "y": 800,
          "name": "Text",
          "fill": "$rt-text-muted",
          "textGrowth": "fixed-width",
          "width": 1480,
          "content": "Routr picks a PBX for new calls. Calls already in progress stay on the PBX that answered them.",
          "fontFamily": "Poppins",
          "fontSize": 15,
          "fontWeight": "normal"
        }
      ]
    },
