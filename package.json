{
  "name": "root",
  "private": true,
  "workspaces": [
    "mods/*"
  ],
  "scripts": {
    "start": "ts-node .scripts/runner",
    "start:one": "cross-env CONFIG_PATH=$(pwd)/config/routr.yaml go run ./cmd/routr-one",
    "start:connect": "cross-env CONFIG_PATH=$(pwd)/config/connect.yaml go run ./cmd/connect",
    "start:simpleauth": "cross-env NODE_ENV=dev PATH_TO_AUTH=$(pwd)/config/auth.yaml METHODS=MESSAGE LOGS_LEVEL=verbose nodemon mods/simpleauth/src/runner",
    "start:data": "cross-env ROUTR_RESOURCES=$(pwd)/config/resources CONFIG_PATH=$(pwd)/config/data.yaml go run ./cmd/data",
    "start:echo": "cross-env NODE_ENV=dev LOGS_LEVEL=verbose nodemon mods/echo/src/runner",
    "start:dispatcher": "cross-env CONFIG_PATH=$(pwd)/config/dispatcher.yaml go run ./cmd/dispatcher",
    "start:location": "cross-env CONFIG_PATH=$(pwd)/config/location.yaml go run ./cmd/location",
    "start:registry": "cross-env CONFIG_PATH=$(pwd)/config/registry.yaml go run ./cmd/registry",
    "start:requester": "cross-env CONFIG_PATH=$(pwd)/config/requester.yaml go run ./cmd/requester",
    "start:edgeport": "cross-env NODE_ENV=dev LOGS_LEVEL=verbose CONFIG_PATH=$(pwd)/config/edgeport.yaml go run ./cmd/edgeport",
    "start:rtprelay": "cross-env CONFIG_PATH=$(pwd)/config/rtprelay.yaml go run ./cmd/rtprelay",
    "start:docs-site": "cd docs-site && npx --yes mint@4.2.1045 dev --port 3333",
    "check:docs-site": "cd docs-site && npx --yes mint@4.2.1045 broken-links",
    "start:deps": "./.scripts/deps.sh up",
    "stop:deps": "./.scripts/deps.sh down",
    "generate:certs": "SERVER_CERT_SUBJECT='/CN=localhost' CA_CERT_SUBJECT='/CN=Self Signed CA' ./.scripts/generate-certs.sh .certs",
    "convert:certs": "./.scripts/convert-to-p12.sh && mv signaling.p12 etc/certs/",
    "make": "npm install && npm run build",
    "test": "cross-env NODE_ENV=dev mocha mods/*/test/*.unit.test.ts --exit",
    "compat": "./scripts/compat.sh",
    "test:echo": "cross-env NODE_ENV=dev ts-node .scripts/echo-test.ts",
    "build": "lerna run build",
    "clean": "./.scripts/clean.sh",
    "bump:version": "rimraf mods/**/.lerna-changed-buster-* && lerna exec -- touch .lerna-changed-buster-$RANDOM",
    "lint": "eslint mods --ext .ts --fix",
    "format": "prettier --write mods/**/src",
    "prepare": "husky install",
    "release": "lerna version $(./.scripts/next-release.sh) --yes --force-publish --message \"chore(release): publish %s [skip ci]\"",
    "version": ".scripts/bump-chart.sh $(node -p \"require('./lerna.json').version\") && node .scripts/changelog-entry.js $(node -p \"require('./lerna.json').version\") && git add ops/charts/connect/Chart.yaml docs-site/changelog.mdx",
    "publish:prerelease": "lerna publish prerelease --no-private --dist-tag next",
    "publish:frompackages": "lerna publish from-package",
    "typecheck": "tsc --noEmit",
    "helm:package": "helm package ops/charts/connect -d .charts",
    "helm:index": "helm repo index .charts --merge .charts/index.yaml",
    "generate:readme": "lerna run generate:readme"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.3",
    "@commitlint/config-conventional": "^17.0.3",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^7.1.2",
    "@types/mocha": "^8.2.3",
    "@types/node": "24.0.14",
    "@types/sinon": "^10.0.6",
    "@types/sinon-chai": "^3.2.4",
    "@types/vinyl": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^5.30.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "buffer": "^6.0.3",
    "chai": "^4",
    "chai-as-promised": "^7.1.1",
    "chai-exclude": "^2.1.0",
    "cross-env": "^7.0.2",
    "dotenv": "^16.6.1",
    "eslint": "^7.23.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-no-loops": "^0.3.0",
    "eslint-plugin-notice": "^0.9.10",
    "eslint-plugin-prettier": "^3.3.1",
    "esm": "^3.2.25",
    "husky": "^5.2.0",
    "jsdoc-to-markdown": "^8.0.0",
    "lerna": "^9.0.3",
    "mocha": "^9.2.2",
    "nodemon": "^3.1.11",
    "nyc": "^15.1.0",
    "path": "^0.12.7",
    "prettier": "^2.6.2",
    "rimraf": "^3.0.2",
    "sinon": "^9.0.2",
    "sinon-chai": "^3.5.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fonoster/logger": "0.6.0",
    "funfix": "^7.0.1",
    "pb-util": "^1.0.3"
  },
  "nodemonConfig": {
    "watch": [
      "./mods/"
    ],
    "ext": "ts",
    "exec": "ts-node",
    "ignore": "**/*.d.ts"
  },
  "nyc": {
    "exclude": [
      "**/*.js"
    ]
  },
  "overrides": {
    "@opentelemetry/api": "^1.10.0",
    "underscore": "^1.13.8"
  }
}
