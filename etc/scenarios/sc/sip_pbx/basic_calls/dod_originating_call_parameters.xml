<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<scenario name="SC-IT.Conf.1.3.1.UAS">

  <recv request="INVITE">
    <action>
      <!--
        The call leaves over trunk-02, which has normalizeToE164 and rewriteFromWithNumber (config/resources/trunks.yaml):
        the Request-URI and To users are +E.164, and From is the Number (number-03, +18295863314) at the Service
        Provider's host, as SIP Connect 1.1 section 9 asks of a SIP-PBX in Registration mode.
      -->
      <ereg regexp=".*INVITE sips?:\+[0-9]+@sip.provider.net.*" search_in="msg" case_indep="true" check_it="true" assign_to="1" />
      <ereg regexp=".*sips?:\+18295863314@sip.provider.net;user=phone.*" search_in="hdr" header="From" case_indep="true" check_it="true" assign_to="1" />
      <!-- rewriteFromWithNumber also puts To at the Service Provider's host, matching the Request-URI -->
      <ereg regexp=".*sips?:\+[0-9]+@sip.provider.net.*" search_in="hdr" header="To" case_indep="true" check_it="true" assign_to="1" />
      <!--
        SIP Connect 1.1 section 9: the asserted identity is a SIP URI carrying a global E.164 number
        with a leading "+" and the user=phone parameter, e.g. sip:+16132581234@example.com;user=phone.
        The host is the Service Provider's domain in Registration mode. A display name may precede it.
      -->
      <ereg regexp=".*&lt;sips?:\+[0-9]+@[0-9a-z.-]+(:[0-9]+)?;user=phone&gt;.*" search_in="hdr" header="P-Asserted-Identity" case_indep="true" check_it="true" assign_to="1" />
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_Record-Route:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0
    ]]>
  </send>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]
      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
    ]]>
  </send>

  <recv request="ACK" />

  <recv request="BYE" />

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:][peer_tag_param]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0
    ]]>
  </send>

</scenario>
