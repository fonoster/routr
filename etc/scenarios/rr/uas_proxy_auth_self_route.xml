<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- The caller sent "Route: <sip:edgeport01:5060;lr>", a name that resolves to the EdgePort
     but is in neither externalAddrs nor aliases. The INVITE must reach the Trunk without it
     (before, the EdgePort sent the INVITE to itself until the caller gave up), and the
     EdgePort answers the Trunk's challenge with the Trunk's credentials. -->
<scenario name="RR.Tst.Plan.1.1.6.UAS">

  <recv request="INVITE">
    <action>
      <ereg regexp="Route:[^\r\n]*edgeport01" search_in="msg" case_indep="true" check_it_inverse="true" assign_to="1" />
      <ereg regexp="2 INVITE" search_in="hdr" header="CSeq" case_indep="true" check_it="true" assign_to="2" />
    </action>
  </recv>
  <Reference variables="1,2" />

  <send>
    <![CDATA[
      SIP/2.0 401 Unauthorized
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0
      Server: SIP Gateway
      WWW-Authenticate: Digest realm="provider", nonce="d6b6b6b6", algorithm=MD5
    ]]>
  </send>

  <recv request="ACK" />

  <!-- The re-sent INVITE carries the Trunk's credentials and CSeq + 1 -->
  <recv request="INVITE">
    <action>
      <ereg regexp="Route:[^\r\n]*edgeport01" search_in="msg" case_indep="true" check_it_inverse="true" assign_to="3" />
      <ereg regexp="3 INVITE" search_in="hdr" header="CSeq" case_indep="true" check_it="true" assign_to="4" />
      <ereg regexp="Digest " search_in="hdr" header="Authorization" case_indep="true" check_it="true" assign_to="5" />
    </action>
  </recv>
  <Reference variables="3,4,5" />

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0
    ]]>
  </send>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]
      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
    ]]>
  </send>

  <recv request="ACK">
    <action>
      <ereg regexp="3 ACK" search_in="hdr" header="CSeq" case_indep="true" check_it="true" assign_to="6" />
    </action>
  </recv>
  <Reference variables="6" />

  <!-- The caller sends "2 BYE"; the challenge on this leg added +1 -->
  <recv request="BYE">
    <action>
      <ereg regexp="3 BYE" search_in="hdr" header="CSeq" case_indep="true" check_it="true" assign_to="7" />
    </action>
  </recv>
  <Reference variables="7" />

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:][peer_tag_param]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:sipp@[local_ip]:[local_port];transport=[transport]>
      Content-Length: 0
    ]]>
  </send>

</scenario>
