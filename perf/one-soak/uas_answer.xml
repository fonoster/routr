<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- one-soak UAS role: the registered callees' phone. It runs in the register
     role's SIPp (-oocsf), so it answers on the socket the callees registered
     from. It answers each INVITE that Routr routes to it with 100, 180 and 200,
     takes the ACK, waits for the caller's BYE and answers 200, then stays a few
     seconds so a retransmitted BYE finds the call and is answered again instead
     of starting a new one. SIPp answers a retransmitted INVITE or BYE it has
     already answered on its own; a second copy of the ACK is taken too. The
     200's Contact is the INVITE's Request-URI (the callee's registered binding,
     with its user part). Record-Route is echoed so the caller's ACK and BYE go
     through Routr. The To tag is built from the caller's From tag, so every
     dialog has its own. -->
<scenario name="Soak UAS">

  <!-- [last_Request_URI] is built from the To header, so read the
       Request-URI (the callee's registered binding) from the request line. -->
  <recv request="INVITE" crlf="true">
    <action>
      <ereg regexp="^INVITE (sips?:[^ ]+) SIP/2.0" search_in="msg" check_it="true" assign_to="requestLine,bindingURI" />
      <ereg regexp=";tag=([^;&gt; ]+)" search_in="hdr" header="From" check_it="true" assign_to="fromTagParam,fromTag" />
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 100 Trying
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:];tag=uas-[$fromTag]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <[$bindingURI]>
      Content-Length: 0
    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:];tag=uas-[$fromTag]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <[$bindingURI]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
    ]]>
  </send>

  <recv request="ACK" crlf="true" />

  <!-- A second ACK: the 200 was retransmitted before the first ACK came. -->
  <recv request="ACK" optional="true" />

  <recv request="BYE" />

  <Reference variables="requestLine,fromTagParam" />

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <!-- Keep the call for the caller's BYE retransmissions (T1 doubling up to
       4 s, 32 s at most): SIPp answers one it has already answered. -->
  <pause milliseconds="8000" />

</scenario>
