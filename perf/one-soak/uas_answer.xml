<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">

<!-- one-soak UAS role: the registered callees' phone. It answers each INVITE
     that Routr routes to it with 100, 180 and 200, takes the ACK, waits for the
     caller's BYE and answers 200. The 200's Contact is the INVITE's
     Request-URI (the callee's registered binding, with its user part), not
     [local_ip], which SIPp guesses when it has no remote host. Record-Route is
     echoed so the caller's ACK and BYE go through Routr. -->
<scenario name="Soak UAS">

  <!-- [last_Request_URI] is built from the To header, so read the
       Request-URI (the callee's registered binding) from the request line. -->
  <recv request="INVITE" crlf="true">
    <action>
      <ereg regexp="^INVITE (sips?:[^ ]+) SIP/2.0" search_in="msg" check_it="true" assign_to="requestLine,bindingURI" />
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 100 Trying
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <[$bindingURI]>
      Content-Length: 0
    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_Record-Route:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <[$bindingURI]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
    ]]>
  </send>

  <recv request="ACK" crlf="true" />

  <recv request="BYE" />

  <Reference variables="requestLine" />

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

</scenario>
